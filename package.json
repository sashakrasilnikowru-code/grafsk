{
  "name": "shift-schedule-app",
  "version": "1.0.0",
  "description": "Desktop and Mobile Shift Scheduler",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build:exe": "electron-builder --win",
    "build:web": "mkdir -p dist && cp index.html dist/",
    "init:android": "npx cap add android",
    "build:apk": "npm run build:web && npx cap sync android && echo 'Откройте папку android в Android Studio для создания APK'"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@capacitor/android": "^6.0.0",
    "@capacitor/core": "^6.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.0.0",
    "electron": "^32.1.0",
    "electron-builder": "^25.0.5"
  },
  "build": {
    "appId": "com.grafsk.shiftschedule",
    "productName": "График смен",
    "directories": {
      "output": "build-exe"
    },
    "win": {
      "target": "nsis"
    }
  }
}
